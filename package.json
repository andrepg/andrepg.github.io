{
  "name": "io.github.andrepg",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite-ssg build && yarn build-sitemap",
    "preview": "vite preview",
    "test:unit": "vitest",
    "typecheck": "vue-tsc --build",
    "lint": "eslint -c eslint.config.js",
    "lint:fix": "eslint -c eslint.config.js --fix",
    "format": "prettier --write src/",
    "build-sitemap": "tsx src/sitemap.ts"
  },
  "dependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@unhead/vue": "^3.4.1",
    "@vueuse/core": "^14.4.0",
    "front-matter": "^4.0.2",
    "node-html-parser": "^9.0.4",
    "prismjs": "^1.30.0",
    "vite-plugin-prismjs": "^0.0.11",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.42",
    "vue-i18n": "11",
    "vue-router": "^5.3.1",
    "xml": "^1.0.1"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/prismjs": "^1.26.6",
    "@types/xml": "^1.0.11",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "daisyui": "^5.7.47",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.0",
    "vite-plugin-markdown": "^2.2.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  }
}
